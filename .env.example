# Optional Real LLM Backend Configuration (copy to .env and populate; never commit .env)
# Select backend: mock_deterministic | mock_stochastic | openai | gemini | anthropic | groq | ollama | hf_local
AGENT_CTI_LLM_BACKEND=mock_deterministic

# OpenAI-compatible endpoint (OpenAI, Groq, vLLM, Ollama /v1, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini REST API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama HTTP
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional local HuggingFace CPU model (requires local or cached weights)
HF_LOCAL_MODEL=

# Runtime security signing key (ephemeral generated if unset; set explicitly for reproducible token verification)
AGENT_CTI_SIGNING_SECRET=

